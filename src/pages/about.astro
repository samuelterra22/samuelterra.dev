---
import Base from '@layouts/Base.astro';
import Button from '@components/Button.astro';
import { person, breadcrumbs } from '@lib/seo';

const title = 'Sobre';
const description =
  'Engenheiro de software e mestre em Ciencia da Computacao em Lavras/MG. Carreira, formacao, stack, principios e docencia.';

const jsonLd = [
  person(),
  breadcrumbs([
    { name: 'Inicio', path: '/' },
    { name: 'Sobre', path: '/about' },
  ]),
];

// Linha do tempo: so o que esta confirmado em docs/bio.md.
const timeline = [
  { year: '2013-2018', what: 'Bacharelado em Ciencia da Computacao, IFMG Campus Formiga' },
  { year: '2017', what: 'Inicio da carreira profissional, Celula Web' },
  { year: '2019-2021', what: 'Mestrado em Ciencia da Computacao, UFLA, linha de redes e sistemas embarcados' },
  { year: '2022-2023', what: 'Coordenador de Desenvolvimento, Delta Global' },
  { year: '2023-2026', what: 'Especialista e depois Team Leader, Stefanini, projeto SICVO para a Caixa' },
  { year: '2026', what: 'Pratica independente pela Volpa: sistemas sob medida, automacao com IA e docencia' },
];
// confirmar: titulo da dissertacao de mestrado (UFLA)
// confirmar: pos-graduacoes em Lideranca e Gestao (Escola Conquer) e Desenvolvimento de IA
//   (Anhanguera); anos a confirmar, so publicar quando houver ano
// confirmar: datas exatas de inicio na Celula Web

// Stack por camada.
const stack = [
  { layer: 'Linguagens', items: 'PHP 8.5, Python, TypeScript' },
  { layer: 'Frameworks', items: 'Laravel 12, FilamentPHP v4' },
  { layer: 'Dados', items: 'PostgreSQL, Redis, pgvector' },
  { layer: 'Infra', items: 'FrankenPHP em modo worker, Docker Swarm, Portainer, Traefik, Oracle Cloud ARM, Vultr S3, GitHub Actions' },
  { layer: 'IA e automacao', items: 'n8n self-hosted, Claude Code, Spec-Driven Development' },
];

// Principios que podem ser citados (docs/bio.md).
const principles = [
  'Ser o primeiro cliente do que vendo: uso todo dia o que construo.',
  'UX desde o primeiro dia e nada de overengineering.',
  'Tres clientes pagantes sem customizacao antes de qualquer modulo. Foi o que o Basal me ensinou.',
];
---

<Base title={title} description={description} path="/about" type="profile" jsonLd={jsonLd}>
  <div class="max-w-[var(--measure)]">
    <h1 class="display-lg">Sobre</h1>
    <p class="lead mt-5 text-ink-muted">
      Engenheiro de software e mestre em Ciencia da Computacao. Construo sistemas com Laravel e IA, em Lavras/MG.
    </p>

    <section class="mt-16">
      <h2 class="display-md">Caminho</h2>
      <ul class="mt-6">
        {
          timeline.map((t) => (
            <li class="flex gap-4 border-t border-hairline py-4">
              <span class="meta w-24 shrink-0">{t.year}</span>
              <span class="body-sm">{t.what}</span>
            </li>
          ))
        }
      </ul>
      <p class="meta mt-3">
        Atuo com desenvolvimento desde 2017. As quatro publicacoes cientificas estao em{' '}
        <a href="/research" class="text-signal-text">Pesquisa</a>.
      </p>
    </section>

    <section class="mt-16">
      <h2 class="display-md">Stack</h2>
      <dl class="mt-6">
        {
          stack.map((s) => (
            <div class="flex gap-4 border-t border-hairline py-4">
              <dt class="label w-32 shrink-0">{s.layer}</dt>
              <dd class="body-sm m-0">{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-16">
      <h2 class="display-md">Principios</h2>
      <ul class="mt-6 space-y-4">
        {principles.map((p) => <li class="body">{p}</li>)}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="display-md">Docencia</h2>
      <p class="body mt-6">
        Em 9 de setembro de 2026 dei o workshop "Desenvolvimento de aplicacoes Laravel: ferramentas,
        performance e qualidade com IA" para a equipe de desenvolvimento da UFLA, em 2 horas.
      </p>
      <p class="body">
        Sou candidato a professor de TI com foco em IA na Fagammon. O material de aula fica em{' '}
        <a href="/research" class="text-signal-text">Pesquisa</a>.
      </p>
    </section>

    <div class="mt-16 border-t border-hairline pt-8">
      <Button href="/contact" variant="secondary">Falar comigo</Button>
    </div>
  </div>
</Base>
