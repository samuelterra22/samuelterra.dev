---
import Base from '@layouts/Base.astro';
import { breadcrumbs } from '@lib/seo';

// Pagina Agora: atualizada no primeiro dia util do mes. O texto abaixo e o ponto de partida;
// a cada mes, troque os itens pelo que esta mesmo em curso. Mantenha curto e concreto.
const updated = '2026-10';

const title = 'Agora';
const description = 'O que Samuel Terra Vieira está estudando e construindo neste mês.';

const jsonLd = [
  breadcrumbs([
    { name: 'Início', path: '/' },
    { name: 'Agora', path: '/now' },
  ]),
];

const studying = [
  'LLM local com 6 GB de VRAM: o que cabe e como servir do Docker.',
  'FrankenPHP em modo worker com Laravel, medindo o que o estado residente cobra.',
];
const building = [
  'Sopro, ditado por voz em tempo real no Windows, usado todo dia.',
  'Chatbot de WhatsApp em n8n com memória semântica em pgvector.',
];
---

<Base title={title} description={description} path="/now" jsonLd={jsonLd}>
  <div class="max-w-[var(--measure)]">
    <h1 class="display-lg">Agora</h1>
    <p class="meta mt-4">Atualizado em {updated}</p>

    <section class="mt-12">
      <h2 class="display-sm">Estudando</h2>
      <ul class="mt-4 space-y-3">
        {studying.map((s) => <li class="body">{s}</li>)}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="display-sm">Construindo</h2>
      <ul class="mt-4 space-y-3">
        {building.map((s) => <li class="body">{s}</li>)}
      </ul>
    </section>
  </div>
</Base>
