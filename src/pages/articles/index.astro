---
import Base from '@layouts/Base.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { readingMinutes, topicLabels, levelLabels } from '@lib/labels';
import { levels, topics } from '../../content.config';
import { getArticles, getNotes, getPaths, articleHref, noteHref, pathHref } from '@lib/content';
import { breadcrumbs } from '@lib/seo';

const [articles, notes, paths] = await Promise.all([getArticles(), getNotes(), getPaths()]);

const title = 'Artigos';
const description =
  'Artigos, notas e trilhas sobre engenharia de software, Laravel e IA. Filtre por tema, nivel ou tipo, ou busque.';

const jsonLd = [
  breadcrumbs([
    { name: 'Inicio', path: '/' },
    { name: 'Artigos', path: '/articles' },
  ]),
];

const sections = [
  { id: 'articles', kind: 'article' as const, label: 'Artigos', items: articles, href: articleHref },
  { id: 'notes', kind: 'note' as const, label: 'Notas', items: notes, href: noteHref },
  { id: 'paths', kind: 'path' as const, label: 'Trilhas', items: paths, href: pathHref },
];
---

<Base title={title} description={description} path="/articles" jsonLd={jsonLd}>
  <div class="max-w-[var(--measure)]">
    <h1 class="display-lg">Artigos</h1>
    <p class="lead mt-5 text-ink-muted">
      Artigos longos, notas curtas e trilhas de estudo. O mesmo texto serve a quem domina e a quem esta comecando.
    </p>

    {/* Busca local com Pagefind. O indice e gerado na build; em dev o campo fica vazio. */}
    <div id="search" class="mt-8"></div>

    {/* Filtros por tema e nivel sao links para as paginas filtradas; tipo sao ancoras. */}
    <nav aria-label="Filtros" class="mt-8 space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="label w-16">Tema</span>
        {
          topics.map((t) => (
            <a href={`/articles/topic/${t}`} class="meta rounded-pill border border-hairline px-3 py-1 no-underline hover:border-ink">
              {topicLabels[t]}
            </a>
          ))
        }
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="label w-16">Nivel</span>
        {
          levels.map((l) => (
            <a href={`/articles/level/${l}`} class="meta rounded-pill border border-hairline px-3 py-1 no-underline hover:border-ink">
              {levelLabels[l]}
            </a>
          ))
        }
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="label w-16">Tipo</span>
        {
          sections.filter((s) => s.items.length > 0).map((s) => (
            <a href={`#${s.id}`} class="meta rounded-pill border border-hairline px-3 py-1 no-underline hover:border-ink">
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>

    {
      sections.map((s) =>
        s.items.length > 0 ? (
          <section id={s.id} class="mt-16 scroll-mt-8">
            <h2 class="display-sm">{s.label}</h2>
            <div class="mt-4">
              {s.items.map((e) => (
                <ArticleCard
                  kind={s.kind}
                  href={s.href(e.id)}
                  title={e.data.title}
                  description={e.data.description}
                  level={e.data.level}
                  minutes={readingMinutes(e.body ?? '')}
                  date={e.data.pubDate}
                  series={'series' in e.data ? e.data.series : undefined}
                />
              ))}
            </div>
          </section>
        ) : null,
      )
    }

    {
      articles.length === 0 && notes.length === 0 && paths.length === 0 && (
        <p class="body mt-12 text-ink-muted">Ainda nao ha nada publicado aqui.</p>
      )
    }
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({
          element: '#search',
          showImages: false,
          showSubResults: true,
          translations: {
            placeholder: 'Buscar nos artigos',
            clear_search: 'Limpar',
            zero_results: 'Nada encontrado para [SEARCH]',
          },
        });
      }
    });
  </script>
</Base>
