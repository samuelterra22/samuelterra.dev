---
import { render } from 'astro:content';
import Article from '@layouts/Article.astro';
import { getNotes, noteHref } from '@lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const path = noteHref(entry.id);
const ogImage = new URL(`/og/${entry.id}.png`, Astro.site).href;
---

<Article
  kind="note"
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  level={entry.data.level}
  topics={entry.data.topic}
  linkedin={entry.data.linkedin}
  headings={headings}
  body={entry.body ?? ''}
  ogImage={ogImage}
>
  <Content />
</Article>
