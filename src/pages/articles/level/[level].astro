---
import Base from '@layouts/Base.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { levelLabels } from '@lib/labels';
import { levels } from '../../../content.config';
import { getReading } from '@lib/content';
import { breadcrumbs } from '@lib/seo';

export async function getStaticPaths() {
  return levels.map((level) => ({ params: { level }, props: { level } }));
}

const { level } = Astro.props;
const label = levelLabels[level];
const items = (await getReading()).filter((i) => i.level === level);
const path = `/articles/level/${level}`;

const jsonLd = [
  breadcrumbs([
    { name: 'Início', path: '/' },
    { name: 'Artigos', path: '/articles' },
    { name: `Nível ${label}`, path },
  ]),
];
---

<Base title={`Nível: ${label}`} description={`Artigos, notas e trilhas de nível ${label}.`} path={path} jsonLd={jsonLd}>
  <div class="max-w-[var(--measure)]">
    <p class="label">Nível</p>
    <h1 class="display-lg mt-2">{label}</h1>
    {
      items.length > 0 ? (
        <div class="mt-8">
          {items.map((i) => (
            <ArticleCard kind={i.kind} href={i.href} title={i.title} description={i.description} level={i.level} minutes={i.minutes} date={i.date} series={i.series} />
          ))}
        </div>
      ) : (
        <p class="body mt-8 text-ink-muted">Ainda não há nada publicado neste nível.</p>
      )
    }
  </div>
</Base>
