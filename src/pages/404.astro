---
import Base from '@layouts/Base.astro';
import Button from '@components/Button.astro';
---

<Base title="Página não encontrada" description="Esta página não existe." path="/404">
  <div class="max-w-[var(--measure)] py-12">
    <p class="label">Erro 404</p>
    <h1 class="display-lg mt-2">Esta página não existe</h1>
    <p class="body mt-5 text-ink-muted">
      O endereço pode ter mudado ou o link estar errado. Os artigos ficam na página de Artigos.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/" variant="primary">Voltar ao início</Button>
      <Button href="/articles" variant="secondary">Ver os artigos</Button>
    </div>
  </div>
</Base>
