---
import Base from '@layouts/Base.astro';
import Button from '@components/Button.astro';
---

<Base title="Pagina nao encontrada" description="Esta pagina nao existe." path="/404">
  <div class="max-w-[var(--measure)] py-12">
    <p class="label">Erro 404</p>
    <h1 class="display-lg mt-2">Esta pagina nao existe</h1>
    <p class="body mt-5 text-ink-muted">
      O endereco pode ter mudado ou o link estar errado. Os artigos ficam na pagina de Artigos.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/" variant="primary">Voltar ao inicio</Button>
      <Button href="/articles" variant="secondary">Ver os artigos</Button>
    </div>
  </div>
</Base>
