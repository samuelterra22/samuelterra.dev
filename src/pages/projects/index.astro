---
import Base from '@layouts/Base.astro';
import { getProjects, projectHref } from '@lib/content';
import { breadcrumbs } from '@lib/seo';

const projects = await getProjects();

const statusLabels: Record<string, string> = {
  active: 'em andamento',
  done: 'concluído',
  paused: 'pausado',
};

const path = '/projects';
const jsonLd = [
  breadcrumbs([
    { name: 'Início', path: '/' },
    { name: 'Projetos', path },
  ]),
];
---

<Base
  title="Projetos"
  description="Estudos de caso: o problema, as decisões, o resultado e o que eu faria diferente."
  path={path}
  jsonLd={jsonLd}
>
  <div class="max-w-[var(--measure)]">
    <h1 class="display-lg">Projetos</h1>
    <p class="lead mt-5 text-ink-muted">
      Cada projeto conta o problema, as decisões de arquitetura, o resultado e o que eu faria diferente.
    </p>

    {
      projects.length > 0 ? (
        <div class="mt-10">
          {projects.map((p) => (
            <article class="group border-t border-hairline py-6">
              <h2 class="display-sm">
                <a href={projectHref(p.id)} class="text-ink no-underline group-hover:underline group-hover:decoration-signal [text-decoration-thickness:4px]">
                  {p.data.title}
                </a>
              </h2>
              <p class="body-sm mt-2 text-ink-muted">{p.data.description}</p>
              <p class="meta mt-3">
                {p.data.year} &middot; {statusLabels[p.data.status]} &middot; {p.data.stack.join(', ')}
              </p>
            </article>
          ))}
        </div>
      ) : (
        <p class="body mt-10 text-ink-muted">Ainda nao ha projetos publicados.</p>
      )
    }
  </div>
</Base>
