---
import { render } from 'astro:content';
import Base from '@layouts/Base.astro';
import Button from '@components/Button.astro';
import { getProjects, projectHref } from '@lib/content';
import { breadcrumbs } from '@lib/seo';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = projectHref(entry.id);

const statusLabels: Record<string, string> = {
  active: 'em andamento',
  done: 'concluído',
  paused: 'pausado',
};

const jsonLd = [
  breadcrumbs([
    { name: 'Início', path: '/' },
    { name: 'Projetos', path: '/projects' },
    { name: entry.data.title, path },
  ]),
];
---

<Base title={entry.data.title} description={entry.data.description} path={path} type="article" jsonLd={jsonLd}>
  <article class="max-w-[var(--measure)]">
    <p class="label">Projeto</p>
    <h1 class="display-lg mt-2">{entry.data.title}</h1>
    <p class="lead mt-5 text-ink-muted">{entry.data.description}</p>
    <p class="meta mt-4 border-y border-hairline py-2">
      {entry.data.year} &middot; {statusLabels[entry.data.status]} &middot; {entry.data.stack.join(', ')}
    </p>

    <div class="article-body mt-8">
      <Content />
    </div>

    {
      (entry.data.repo || entry.data.url) && (
        <div class="mt-10 flex flex-wrap gap-3 border-t border-hairline pt-8">
          {entry.data.repo && (
            <Button href={entry.data.repo} variant="secondary">Repositorio</Button>
          )}
          {entry.data.url && <Button href={entry.data.url} variant="secondary">Ver no ar</Button>}
        </div>
      )
    }
  </article>
</Base>

<style>
  .article-body :global(h2) { margin-top: var(--space-12); }
  .article-body :global(h3) { margin-top: var(--space-8); }
  .article-body :global(ul), .article-body :global(ol) { margin: 0 0 var(--space-4); padding-left: var(--space-6); }
  .article-body :global(li) { margin-bottom: var(--space-2); }
</style>
