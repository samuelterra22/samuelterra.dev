---
// Item de lista da Home e da pagina Artigos: tipo em label, titulo em display-sm (o link inteiro),
// frase-resumo em body-sm e metadados em meta. E lista, nao grade: o card ocupa a largura toda.
// Nunca recebe imagem. Rascunho nunca chega aqui (filtrado na pagina).
import Level from './Level.astro';
import { kindLabels, isoDate, type Kind, type Level as LevelType } from '@lib/labels';

interface Props {
  kind: Kind;
  href: string;
  title: string;
  description: string;
  level: LevelType;
  minutes: number;
  date: Date;
  series?: string;
}
const { kind, href, title, description, level, minutes, date, series } = Astro.props;
---

<article class="group border-t border-hairline py-6">
  <p class="label mb-2">
    {kindLabels[kind]}{series && <span class="normal-case tracking-normal"> &middot; série {series}</span>}
  </p>
  <h3 class="display-sm">
    <a
      href={href}
      class="text-ink no-underline [text-decoration-thickness:4px] group-hover:underline group-hover:decoration-signal"
      >{title}</a
    >
  </h3>
  <p class="body-sm mt-2 text-ink-muted">{description}</p>
  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
    <Level level={level} />
    <span class="text-hairline" aria-hidden="true">&middot;</span>
    <span class="meta">{minutes} min</span>
    <span class="text-hairline" aria-hidden="true">&middot;</span>
    <time class="meta" datetime={isoDate(date)}>{isoDate(date)}</time>
  </div>
</article>
