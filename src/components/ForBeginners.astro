  class="my-8 rounded-md border border-hairline bg-paper-raised px-5 py-4"
>
  <p class="label mb-2 text-signal-text">Para quem está começando</p>
  <div class="body-sm space-y-3 [&>p]:m-0">
    <slot />
  </div>
</aside>
